APP_NAME="UnicoPag MED"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Produção: MySQL/MariaDB, como o KYC. Local/CI: sqlite funciona.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=unicopag_med
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- MED -------------------------------------------------------------------
# Prazo interno de resposta (horas desde a abertura do MED). A Woovi não publica
# prazo na doc: 72h é referência de mercado - confirmar com a Woovi.
MED_PRAZO_RESPOSTA_HORAS=72
# Prazo que a Woovi aplica de fato (~96h, medido em 26/10/2026): o envio não tenta depois disso.
MED_PRAZO_WOOVI_HORAS=96
# Resposta automática: de hora em hora (minuto 20) o med:responder responde sozinho o que
# passa nas travas. MED_DEFENDER_NAO_RECOMENDADOS contesta também os "não defender"
# (pagador diferente do cliente, venda não localizada, KYC não aprovado); dado incoerente
# (valor ou devolução) nunca sai. Resultado: php artisan med:resultados.
MED_RESPOSTA_AUTOMATICA=false
MED_DEFENDER_NAO_RECOMENDADOS=false
# Janela de trabalho: fila, painel e sincronização só com os MEDs abertos nos últimos N
# dias (0 = todos). `php artisan med:podar --confirmar` apaga o que ficou de fora.
MED_JANELA_DIAS=14
# Aviso ao lojista (e-mail e WhatsApp). Desligado até a operação estar organizada.
MED_AVISO_LOJISTA=false
# Fila: com quantas horas restantes o prazo fica amarelo / vermelho.
MED_FILA_ALERTA_HORAS=24
MED_FILA_CRITICO_HORAS=8
# Folga do link do seller depois do prazo.
MED_LINK_FOLGA_HORAS=24
MED_EVIDENCIAS_MAX_ARQUIVOS=10
MED_EVIDENCIAS_DISK=local

# --- Woovi -----------------------------------------------------------------
# Sandbox: https://api.woovi-sandbox.com
WOOVI_BASE_URL=https://api.woovi.com
WOOVI_TIMEOUT=20
# AppID de um aplicativo da conta mestre/parceira da ÚnicoPag criado SÓ para o MED, com
# os escopos PARTNER_COMPANY_GET_LIST e PARTNER_APPLICATION_POST (não reaproveite a chave
# do unico-api, que tem acesso total). Com ele o MED importa as subcontas sozinho
# (med:importar-contas, de hora em hora). Vazio = contas só à mão ou pelo unico-api.
WOOVI_MASTER_APP_ID=
WOOVI_PARTNER_APPLICATION_NAME="UnicoPag MED"
# Escopos do aplicativo criado em cada subconta. Vazio = a lista padrão (só o que o MED
# chama). Não existe modo "sem escopos".
WOOVI_PARTNER_APPLICATION_SCOPES=
# false desliga só a importação das subcontas (conta sem a função de parceiro da Woovi).
WOOVI_PARTNER_IMPORT=true

# Defesa com IA (Claude): rascunho da defesa a partir do dossiê conferido. Vazio = desligada.
ANTHROPIC_API_KEY=
MED_IA_MODEL=claude-opus-5-5
MED_IA_EFFORT=high
# Rascunho da defesa gerado sozinho depois da montagem do dossiê (uma vez por caso).
MED_IA_AUTOMATICA=true
# file_id (recomendado; sem a feature DISPUTE_EVIDENCE_FILE_ID cai sozinho para o
# link do arquivo guardado na Woovi) | woovi_url (sempre pelo link da Woovi) |
# url (a Woovi baixa um link assinado daqui; exige APP_URL público).
WOOVI_EVIDENCE_MODE=file_id
WOOVI_EVIDENCE_URL_TTL_MINUTES=1440
# Desligar só em ambiente local.
WOOVI_WEBHOOK_VERIFY_SIGNATURE=true
WOOVI_WEBHOOK_PUBLIC_KEYS_URL=https://api.woovi.com/api/v1/webhook/public-keys

# --- unico-api ---------------------------------------------------------------
# X-API-Key das rotas server-to-server (PUT /api/woovi-accounts e
# GET /api/woovi-accounts/{account_id}/disputes). Sem valor = rotas negam.
API_KEY=

# --- WhatsApp oficial (Kapso) ----------------------------------------------
# Mesmo número e mesma chave de projeto do KYC. Sem chave + número, aviso só por e-mail.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# Segredo do webhook do MED (diferente do KYC). Depois: php artisan med:registrar-webhook-kapso
KAPSO_WEBHOOK_SECRET=
# Template aprovado na Meta que abre a conversa ({{1}} = primeiro nome, sem link).
MED_WHATSAPP_TEMPLATE=
MED_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# --- Dossiê automático e envio automático --------------------------------
# Ao receber o MED, puxa transação/cobrança/devoluções/comprovante na Woovi, a venda e o
# cadastro no unico-api e o status do KYC, e já monta as evidências. Ligar depois de
# confirmar que o AppID das subcontas tem TRANSACTION_GET e CHARGE_GET.
MED_DOSSIE_HABILITADO=false
MED_DOSSIE_COMPROVANTE_WOOVI=true
# Envio automático depois da defesa do seller (também exige opt-in na conta).
MED_ENVIO_AUTOMATICO=false
MED_ENVIO_AUTOMATICO_TETO_CENTAVOS=100000
# Lista branca da alegação: fora dela (conta invadida, coação, UNKNOWN, OTHER...) vai ao analista.
MED_ENVIO_AUTOMATICO_SITUACOES_PERMITIDAS=SCAM
# Sem a alegação (situationType, feature "MED API" da Woovi) não envia sozinho.
MED_ENVIO_AUTOMATICO_EXIGIR_SITUACAO=true
# Entre aspas: valor com espaço sem aspas derruba o boot (Dotenv).
MED_ENVIO_AUTOMATICO_MOTIVOS_BLOQUEADOS="invad,invas,takeover,acesso indevido,sequestr,coação,coacao,coercion,extors,roubad,furtad,clonad,hacke"

# unico-api, chamado pelo MED (de preferência uma integração "med" só de leitura).
UNICOPAG_API_BASE_URL=https://vps1.unicopag.com.br
UNICOPAG_API_KEY=
UNICOPAG_REGISTER_ENDPOINT=/api/kyc-panel/accounts/{account_id}/register
# Venda (contrato em doc/MED_KNOWLEDGE_BASE.md 8.1). Busca sem conta: os MEDs caem na conta mestre.
UNICOPAG_SALE_ENDPOINT="/api/med/sales/lookup?correlation_id={correlation_id}&end_to_end_id={end_to_end_id}&txid={txid}"
# KYC (status do onboarding do seller).
KYC_BASE_URL=https://kyc.unicopag.com.br

# --- Alertas -----------------------------------------------------------------
# Canal da operação de MED no Discord. Vazio = só log.
DISCORD_MED_WEBHOOK_URL=
DISCORD_MED_ROLE_ID=
